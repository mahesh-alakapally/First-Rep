# Development placeholders only. Docker Compose already supplies local defaults.
# Do not put real Stripe, OpenAI, or production secrets in this file.

MYSQL_DATABASE=firstrep
MYSQL_USER=firstrep
MYSQL_PASSWORD=firstrep
MYSQL_ROOT_PASSWORD=rootlocal

RABBITMQ_DEFAULT_USER=firstrep
RABBITMQ_DEFAULT_PASS=firstrep

MINIO_ROOT_USER=firstrep
MINIO_ROOT_PASSWORD=firstrep-secret
MINIO_BUCKET=firstrep-private

# At least 32 bytes. Replace outside local development.
JWT_SECRET=dev-only-firstrep-jwt-secret-change-me-32b

# simulator (default) or stripe
FIRSTREP_BILLING_MODE=simulator
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# mock (default) or openai
FIRSTREP_AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_PROMPT_VERSION=rubric-v1

APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
